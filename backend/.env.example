# ===== Obligatorias (las exige Quackback) =====
# PostgreSQL CON extensión pgvector (Neon, Supabase, o tu propio Postgres)
DATABASE_URL=postgres://user:pass@host:5432/quackback
# Redis compatible con BullMQ (rediss://... si es externo)
REDIS_URL=redis://default:pass@host:6379
# openssl rand -base64 32   (mín. 32 caracteres)
SECRET_KEY=
# URL PÚBLICA = el dominio de Vercel (login, cookies y callbacks dependen de esto)
BASE_URL=https://tu-proyecto.vercel.app

# ===== Túnel (debe ser IDÉNTICO en Vercel) =====
# node index.js --gen-secret
TUNNEL_SECRET=

# ===== Opcionales =====
# Puerto público del gateway. En Pterodactyl se toma de SERVER_PORT automáticamente.
# GATEWAY_PORT=25565
APP_PORT=3000
REPO_URL=https://github.com/QuackbackIO/quackback.git
REPO_REF=main
AUTO_UPDATE=false
BUN_VERSION=1.4.0
# Motor para SERVIR la app: bun (por defecto) o node. Si node falla al arrancar, cae a bun solo.
# RUNTIME=node
# NODE_START_CMD=node apps/web/.output/server/index.mjs
# Comando de arranque en producción (revisa apps/web/package.json si falla)
START_CMD=bun run --cwd apps/web start
# Certificado TLS opcional para el gateway (si no, HTTP; el contenido ya va cifrado)
# TLS_CERT=./certs/fullchain.pem
# TLS_KEY=./certs/privkey.pem
