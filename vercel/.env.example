# Variables de entorno del proyecto en Vercel (Settings > Environment Variables)
ORIGIN_URL=http://IP_PUBLICA_DEL_NODO:PUERTO_DEL_GATEWAY
TUNNEL_SECRET=el_mismo_valor_que_en_el_backend
# Solo si el gateway usa HTTPS con certificado autofirmado:
# ORIGIN_ALLOW_SELF_SIGNED=true
# Rutas con hash inmutable que Vercel puede cachear en su CDN (regex):
# IMMUTABLE_PATH_REGEX=^/assets/
